{
  "name": "agent-notch",
  "version": "1.0.0",
  "description": "Cross-platform system tray app to monitor AI coding agents — Claude Code, Codex, Cursor, and more.",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "test": "node --test",
    "permission-bridge": "node src/main/permission-bridge.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "engines": { "node": ">=20" },
  "author": "AgentNotch",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.10.5",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "electron-store": "^10.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
